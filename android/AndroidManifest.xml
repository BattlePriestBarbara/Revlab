<?xml version="1.0" encoding="utf-8"?>
<!--
  RevLab Mobile: a client for a RevLab instance running on the desktop.

  It shows the same dashboard the browser gets, so the phone becomes a second
  screen for the workbench (useful while the PC is busy with Ghidra). The only
  permission it asks for is INTERNET, and cleartext HTTP is allowed because the
  workbench lives on the local network: there is no cloud service here.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.revlab.mobile"
    android:versionCode="1"
    android:versionName="0.2.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
